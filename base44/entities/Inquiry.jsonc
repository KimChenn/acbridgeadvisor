{
  "name": "Inquiry",
  "type": "object",
  "properties": {
    "focus": {
      "type": "string",
      "description": "What the prospect wants to achieve (e.g. strategic partnership in fintech)."
    },
    "stage": {
      "type": "string",
      "description": "Where the prospect's business is today (e.g. exploring partnerships, scaling relationships, optimizing CRM)."
    },
    "email": {
      "type": "string",
      "description": "Email address provided by the prospect."
    },
    "phone": {
      "type": "string",
      "description": "Phone number provided by the prospect."
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "won",
        "archived"
      ],
      "default": "new"
    }
  },
  "required": [
    "focus",
    "email",
    "phone"
  ]
}